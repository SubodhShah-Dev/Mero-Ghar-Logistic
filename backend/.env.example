# Server
PORT=5000
BACKEND_URL=http://localhost:5000

# MySQL (XAMPP / MariaDB). Defaults match a stock XAMPP install:
#   host 127.0.0.1, user root, empty password, db meroghar_db.
# The database is created automatically on first start if it does not exist.
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=
DB_NAME=meroghar_db
DB_PORT=3306

# Seed demo accounts (admin/vendor/customer @test.com). Seeding runs by default
# outside production, and only when SEED_DEMO_DATA=true in production.
# SEED_DEMO_DATA=true

# JWT Secret — change to a random string in production
JWT_SECRET=change-this-to-a-random-secret

# AI Chatbot (Google Gemini) — get free key at https://aistudio.google.com/apikey
# Leave empty to use built-in rule-based fallback
GEMINI_API_KEY=

# OpenRouteService (geocoding + distance matrix) — get free key at https://openrouteservice.org/dev/#/login
ORS_API_KEY=