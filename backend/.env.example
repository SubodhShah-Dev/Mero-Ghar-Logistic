# Server
PORT=5000
BACKEND_URL=http://localhost:5000

# Database (dual-driver)
# DB_DRIVER=auto tries MySQL first and falls back to a file-based SQLite DB.
#   auto   (default) try MySQL, else use SQLite
#   mysql  require MySQL (fails fast if unreachable)
#   sqlite force the file-based SQLite DB
DB_DRIVER=auto

# MySQL (used when reachable; e.g. Railway MySQL proxy or TiDB Cloud Starter)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=meroghar_db

# TLS for managed MySQL-compatible hosts (TiDB Cloud Serverless requires TLS)
#   MYSQL_SSL=true            enable TLS on the MySQL connection
#   MYSQL_SSL_CA=/path/to/ca.pem        CA cert file (relative paths work)
#   MYSQL_SSL_CA_B64=<base64>           ...or the same CA as a base64 string
MYSQL_SSL=false
MYSQL_SSL_CA=
MYSQL_SSL_CA_B64=

# Seed demo accounts (admin/vendor/customer @test.com). Seeding runs by default
# outside production, and only when SEED_DEMO_DATA=true in production.
# Useful on the first deploy so an admin account exists.
# SEED_DEMO_DATA=true

# SQLite fallback file (used when MySQL is down or DB_DRIVER=sqlite)
DB_PATH=./data/meroghar.db

# Frontend
FRONTEND_URL=http://localhost:5173

# JWT Secret — change to a random string in production
JWT_SECRET=change-this-to-a-random-secret

# AI Chatbot (Google Gemini) — get free key at https://aistudio.google.com/apikey
# Leave empty to use built-in rule-based fallback
GEMINI_API_KEY=

# OpenRouteService (geocoding + distance matrix) — get free key at https://openrouteservice.org/dev/#/login
ORS_API_KEY=
